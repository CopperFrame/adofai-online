{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adofai-port-online",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // plano gratuito: Durable Objects precisam usar o armazenamento SQLite
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }]
}
